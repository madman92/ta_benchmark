#!/usr/bin/env bash
set -e

DIR="$(cd "$(dirname "$0")" && pwd)"

if ! command -v inotifywait &>/dev/null; then
    echo "Install inotify-tools: sudo apt install inotify-tools"
    exit 1
fi

echo "Watching $DIR for changes... (Ctrl+C to stop)"

inotifywait -m -r -e modify,create,delete,move \
    --exclude '(\.git|vendor|var|docker|\bwatch$)' \
    "$DIR" \
    --format '%w%f' 2>/dev/null |
while read -r file; do
    echo "Change detected: $file"
    docker compose exec -T app php bin/console openswoole:server:stop 2>/dev/null || true
done
