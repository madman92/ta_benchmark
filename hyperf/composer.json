        "hyperf/command": "~3.1.0",
        "hyperf/config": "~3.1.0",
        "hyperf/logger": "~3.1.0",
        "hyperf/engine": "^2.10",
        "hyperf/laminas-mime": "^3.0"
    },
    "autoload": {
